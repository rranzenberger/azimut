generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String?
  password      String
  role          Role       @default(EDITOR)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  assignedLeads Lead[]     @relation("LeadAssignedTo")
  makingOfs     MakingOf[] @relation("UserMakingOf")
}

model Market {
  id                String    @id @default(uuid())
  code              String    @unique
  labelPt           String
  labelEn           String
  heroMessagePt     String?
  heroMessageEn     String?
  priority          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  heroMessageEs     String?
  heroMessageFr     String?
  labelEs           String?
  labelFr           String?
  highlightProjects Project[]
}

model Media {
  id                  String             @id @default(uuid())
  type                MediaType          @default(IMAGE)
  originalUrl         String
  thumbnailUrl        String?
  mediumUrl           String?
  largeUrl            String?
  webpUrl             String?
  avifUrl             String?
  width               Int?
  height              Int?
  sizeBytes           Int?
  durationSeconds     Int?
  format              String?
  contentType         String?
  altPt               String?
  altEn               String?
  altEs               String?
  altFr               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  imageType           String?
  pageSlug            String?
  sectionSlug         String?
  servicesTags        String[]
  makingOfId          String?
  academyCourseCovers AcademyCourse[]
  academyPastEvents   AcademyPastEvent[]
  blogPostCovers      BlogPost[]         @relation("BlogPostCover")
  makingOf            MakingOf?          @relation("MakingOfMedia", fields: [makingOfId], references: [id])
  analysis            MediaAnalysis?
  pageDemoreelVideos  Page[]             @relation("PageDemoreelVideo")
  pageHeroBackgrounds Page[]             @relation("PageHeroBackground")
  projectHero         Project?
  projectGalleries    ProjectMedia[]

  @@index([pageSlug])
  @@index([sectionSlug])
}

model Tag {
  id        String      @id @default(uuid())
  slug      String      @unique
  labelPt   String
  labelEn   String
  labelEs   String?
  labelFr   String?
  category  TagCategory
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  blogPosts BlogPost[]  @relation("BlogPostToTag")
  projects  Project[]   @relation("ProjectToTag")
}

model Service {
  id             String        @id @default(uuid())
  slug           String        @unique
  titlePt        String
  titleEn        String
  titleEs        String?
  titleFr        String?
  descriptionPt  String?
  descriptionEn  String?
  descriptionEs  String?
  descriptionFr  String?
  icon           String?
  /// Imagem do card na página Solutions (/what) — URL pública (upload CDN ou externa)
  cardImageUrl   String?
  status         ServiceStatus @default(PUBLISHED)
  priority       Int           @default(0)
  segments       String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  faqsPt         Json?
  faqsEn         Json?
  faqsEs         Json?
  faqsFr         Json?
  longDescPt     Json?
  longDescEn     Json?
  longDescEs     Json?
  longDescFr     Json?
  deliverablesPt Json?
  deliverablesEn Json?
  deliverablesEs Json?
  deliverablesFr Json?
  processPt      Json?
  processEn      Json?
  processEs      Json?
  processFr      Json?
  technologies   String[]      @default([])
  projects       Project[]     @relation("ProjectToService")
}

model Project {
  id                  String               @id @default(uuid())
  slug                String               @unique
  title               String
  shortTitle          String?
  summaryPt           String?
  summaryEn           String?
  summaryEs           String?
  summaryFr           String?
  city                String?
  stateProvince       String?
  country             String?
  year                Int?
  client              String?
  type                String?
  featured            Boolean              @default(false)
  priorityHome        Int                  @default(0)
  status              ProjectStatus        @default(DRAFT)
  ctaLabelPt          String?
  ctaLabelEn          String?
  ctaUrl              String?
  heroImageId         String?              @unique
  marketId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  descriptionEn       String?
  descriptionEs       String?
  descriptionFr       String?
  descriptionPt       String?
  azimutContributions String[]
  creditText          String?
  creditType          CreditType?
  monitorEnabled      Boolean              @default(false)
  monitorKeywords     String[]
  projectCategory     String[]             @default([])
  workType            String[]             @default([])
  technologies        String[]             @default([])
  industry            String?
  azimutRole          String[]             @default([])
  duration            String?
  awards              Json?
  metrics             Json?
  videoUrl            String?
  videoShowreel       String?
  externalLinks       Json?
  partnerLogos        String[]             @default([])
  beforeAfterImages   Json?
  exhibitionCities    String[]             @default([])
  currentCity         String?
  exhibitionStatus    String?
  isItinerant         Boolean?             @default(false)
  hasDetailPage       Boolean              @default(false)
  thumbnailUrl        String?              @db.VarChar(500)
  seoTitlePt          String?
  seoTitleEn          String?
  seoTitleEs          String?
  seoTitleFr          String?
  seoDescPt           String?
  seoDescEn           String?
  seoDescEs           String?
  seoDescFr           String?
  seoKeywords         String[]             @default([])
  month               Int?
  partnership         String?
  coproduction        String?
  yearStart           Int?
  monthStart          Int?
  yearEnd             Int?
  monthEnd            Int?
  heroImageFit        String?
  heroImagePosition   String?
  monitoredPosts      BlogPostMonitor[]    @relation("ProjectMonitoredPosts")
  makingOfs           MakingOf[]           @relation("ProjectMakingOf")
  pageViews           PageView[]
  heroImage           Media?               @relation(fields: [heroImageId], references: [id])
  market              Market?              @relation(fields: [marketId], references: [id])
  interactions        ProjectInteraction[]
  gallery             ProjectMedia[]
  services            Service[]            @relation("ProjectToService")
  tags                Tag[]                @relation("ProjectToTag")
  sections            Section[]            @relation("SectionProjects")

  @@index([projectCategory], type: Gin)
  @@index([industry])
  @@index([azimutRole], type: Gin)
  @@index([currentCity])
  @@index([exhibitionStatus])
  @@index([technologies], type: Gin)
  @@index([workType], type: Gin)
}

model Page {
  id                       String     @id @default(uuid())
  name                     String
  slug                     String     @unique
  seoTitlePt               String?
  seoTitleEn               String?
  seoDescPt                String?
  seoDescEn                String?
  status                   PageStatus @default(PUBLISHED)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  heroSloganPt             String?
  heroSloganEn             String?
  heroSloganEs             String?
  heroSloganFr             String?
  heroSubtitleEn           String?
  heroSubtitleEs           String?
  heroSubtitleFr           String?
  heroSubtitlePt           String?
  seoDescEs                String?
  seoDescFr                String?
  seoTitleEs               String?
  seoTitleFr               String?
  pillar1Pt                String?
  pillar1En                String?
  pillar1Es                String?
  pillar1Fr                String?
  pillar2Pt                String?
  pillar2En                String?
  pillar2Es                String?
  pillar2Fr                String?
  pillar3Pt                String?
  pillar3En                String?
  pillar3Es                String?
  pillar3Fr                String?
  heroBackgroundImageId    String?
  demoreelVideoId          String?
  heroBackgroundImageUrl   String?
  demoreelVideoUrl         String?
  // Bloco Quem Somos (Studio/Overview): 1 imagem por idioma (URL). PT cai no legado heroBackgroundImageUrl.
  overviewImagePtUrl       String?
  overviewImageEnUrl       String?
  overviewImageEsUrl       String?
  overviewImageFrUrl       String?
  heroDescriptionMobilePt  String?
  heroDescriptionMobileEn  String?
  heroDescriptionMobileEs  String?
  heroDescriptionMobileFr  String?
  heroDescriptionDesktopPt String?
  heroDescriptionDesktopEn String?
  heroDescriptionDesktopEs String?
  heroDescriptionDesktopFr String?
  curationTitlePt          String?
  curationTitleEn          String?
  curationTitleEs          String?
  curationTitleFr          String?
  curationDescriptionPt    String?
  curationDescriptionEn    String?
  curationDescriptionEs    String?
  curationDescriptionFr    String?
  curationButtonTextPt     String?
  curationButtonTextEn     String?
  curationButtonTextEs     String?
  curationButtonTextFr     String?
  curationFilterCategory   String?
  demoreelVideo            Media?     @relation("PageDemoreelVideo", fields: [demoreelVideoId], references: [id])
  heroBackgroundImage      Media?     @relation("PageHeroBackground", fields: [heroBackgroundImageId], references: [id])
  sections                 Section[]
}

model Section {
  id             String    @id @default(uuid())
  pageId         String
  order          Int       @default(0)
  type           String
  layout         String?
  titlePt        String?
  titleEn        String?
  titleEs        String?
  titleFr        String?
  bodyPt         String?
  bodyEn         String?
  bodyEs         String?
  bodyFr         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  page           Page      @relation(fields: [pageId], references: [id])
  linkedProjects Project[] @relation("SectionProjects")

  @@index([order])
  @@index([pageId])
}

model AcademyCourse {
  id            String   @id @default(uuid())
  order         Int      @default(0)
  imageId       String?
  titlePt       String?
  titleEn       String?
  titleEs       String?
  titleFr       String?
  descriptionPt String?
  descriptionEn String?
  descriptionEs String?
  descriptionFr String?
  pricePt       String?
  priceEn       String?
  durationPt    String?
  durationEn    String?
  levelPt       String?
  levelEn       String?
  category      String?
  tags          String[] @default([])
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  image         Media?   @relation(fields: [imageId], references: [id])

  @@index([order])
}

model AcademyPastEvent {
  id        String   @id @default(uuid())
  order     Int      @default(0)
  mediaId   String?
  captionPt String?
  captionEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media?   @relation(fields: [mediaId], references: [id])

  @@index([order])
}

model CompanyHistory {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  year          Int
  yearEnd       Int?
  displayOrder  Int      @default(0)
  type          String
  titlePt       String
  titleEn       String
  titleEs       String?
  titleFr       String?
  descriptionPt String?
  descriptionEn String?
  descriptionEs String?
  descriptionFr String?
  bulletsPt     String[]
  bulletsEn     String[]
  bulletsEs     String[]
  bulletsFr     String[]
  icon          String?
  logoUrl       String?
  externalLink  String?
  isPublished   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([year])
  @@index([type])
  @@index([isPublished])
  @@index([displayOrder])
}

model TeamMembers {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug         String   @unique
  name         String
  rolePt       String
  roleEn       String
  roleEs       String?
  roleFr       String?
  credentialPt String?
  credentialEn String?
  credentialEs String?
  credentialFr String?
  bioPt        String?
  bioEn        String?
  bioEs        String?
  bioFr        String?
  photoUrl     String?
  photoMediaId String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([displayOrder])
}

model Credentials {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  order       Int      @default(0)
  icon        String?
  textPt      String
  textEn      String
  textEs      String?
  textFr      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([order])
  @@index([isPublished])
}

model ProjectMedia {
  id              String   @id @default(uuid())
  projectId       String
  mediaId         String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  captionPt       String?
  captionEn       String?
  captionEs       String?
  captionFr       String?
  displayFit      String?
  displayPosition String?
  displayScale    Float?
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
  @@index([projectId, order])
}

model VisitorSession {
  sessionId             String               @id
  ipAddress             String?
  userAgent             String?
  language              String?
  country               String?
  region                String?
  city                  String?
  duration              Int                  @default(0)
  lastActivityAt        DateTime             @default(now())
  leadId                String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  visitorFingerprint    String?              @unique
  deviceType            String?
  browser               String?
  os                    String?
  screenResolution      String?
  referrer              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  visitCount            Int                  @default(1)
  isReturning           Boolean              @default(false)
  isPWAInstalled        Boolean              @default(false)
  bounceRate            Boolean              @default(false)
  engagementScore       Int                  @default(0)
  conversionProbability Float?
  interestScore         InterestScore?
  pwaInstalls           PWAInstall[]
  pageViews             PageView[]
  projectInteractions   ProjectInteraction[]
  visitorBehaviors      VisitorBehavior[]
  lead                  Lead?                @relation(fields: [leadId], references: [id])

  @@index([visitorFingerprint])
  @@index([country])
  @@index([isReturning])
  @@index([isPWAInstalled])
  @@index([createdAt])
  @@index([lastActivityAt])
}

model PageView {
  id          String         @id @default(uuid())
  sessionId   String
  pageSlug    String?
  projectSlug String?
  projectId   String?
  timeSpent   Int            @default(0)
  scrollDepth Int            @default(0)
  viewedAt    DateTime       @default(now())
  project     Project?       @relation(fields: [projectId], references: [id])
  session     VisitorSession @relation(fields: [sessionId], references: [sessionId])

  @@index([pageSlug])
  @@index([sessionId])
  @@index([viewedAt])
}

model ProjectInteraction {
  id        String                 @id @default(uuid())
  sessionId String
  projectId String
  type      ProjectInteractionType @default(VIEW)
  metadata  Json
  createdAt DateTime               @default(now())
  project   Project                @relation(fields: [projectId], references: [id])
  session   VisitorSession         @relation(fields: [sessionId], references: [sessionId])

  @@index([projectId])
  @@index([sessionId])
}

model InterestScore {
  sessionId           String         @id
  museumScore         Int            @default(0)
  brandScore          Int            @default(0)
  festivalScore       Int            @default(0)
  cityScore           Int            @default(0)
  educationScore      Int            @default(0)
  researchScore       Int            @default(0)
  vrScore             Int            @default(0)
  aiScore             Int            @default(0)
  installationScore   Int            @default(0)
  conversionScore     Int            @default(0)
  visitorType         String?
  recommendedProjects Json?
  suggestedAction     String?
  suggestedPage       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  session             VisitorSession @relation(fields: [sessionId], references: [sessionId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Lead {
  id                    String                  @id @default(uuid())
  name                  String
  email                 String
  phone                 String?
  company               String?
  position              String?
  leadType              LeadType                @default(CONTACT_FORM)
  projectType           String?
  budget                String?
  timeline              String?
  description           String?
  sourceUrl             String?
  referrer              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  status                LeadStatus              @default(NEW)
  priority              LeadPriority            @default(MEDIUM)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  assignedToId          String?
  assignedAt            DateTime?
  notes                 String?
  lastContactAt         DateTime?
  leadScore             Int                     @default(0)
  organizationType      String?
  estimatedValue        Float?
  interestInGrants      Boolean                 @default(false)
  country               String?
  city                  String?
  age                   Int?
  areaInterest          String?
  budgetRange           String?
  comments              String?
  currentSituation      String?
  englishLevel          String?
  fundingSource         String?
  hasPortfolio          String?
  howHeard              String?
  intakeYear            String?
  targetSchool          String?
  newsletterSource      String?
  preferredLanguage     String?
  wantsNewsletter       Boolean                 @default(false)
  enriched_profile      Json?
  conversation_context  String?
  recommended_approach  String?
  enrichment_status     String?                 @default("pending") @db.VarChar(20)
  enriched_at           DateTime?               @db.Timestamp(6)
  lead_score            Int?                    @default(0)
  decision_power        String?                 @db.VarChar(20)
  detected_city         String?                 @db.VarChar(100)
  detected_company      String?                 @db.VarChar(200)
  linkedin_url          String?                 @db.VarChar(500)
  leadIntelligence      Json?
  classification        String?
  riskScore             Int?
  qualityScore          Int?
  decisionStatus        String?
  reviewRequired        Boolean?                @default(false)
  emailSent             Boolean?                @default(false)
  emailSentAt           DateTime?               @db.Timestamp(6)
  emailProviderId       String?
  whatsappSent          Boolean?                @default(false)
  whatsappSentAt        DateTime?               @db.Timestamp(6)
  fingerprint           String?
  behavior              Json?
  enrichment            Json?
  flags                 String[]
  ambiente              String?                 @default("producao") @db.VarChar(20)
  cluster               String?                 @db.VarChar(5)
  tier                  String?                 @db.VarChar(5)
  tipo_relacao          String?                 @default("cliente_potencial") @db.VarChar(30)
  leadSource            String?                 @default("inbound")
  prospeccaoId          String?
  assignedTo            User?                   @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  ProspeccaoAtiva       ProspeccaoAtiva?        @relation(fields: [prospeccaoId], references: [id])
  editalLeads           LeadEdital[]
  newsletterSubscriber  NewsletterSubscriber[]
  sessions              VisitorSession[]
  conversation_triggers conversation_triggers[]
  enrichment_sources    enrichment_sources[]
  lead_interactions     lead_interactions[]
  sent_emails           sent_emails[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([leadScore])
  @@index([email])
  @@index([leadSource])
  @@index([prospeccaoId])
  @@index([classification], map: "idx_lead_classification")
  @@index([createdAt], map: "idx_lead_createdat")
  @@index([email], map: "idx_lead_email")
  @@index([enrichment_status], map: "idx_lead_enrichment_status")
  @@index([lead_score], map: "idx_lead_lead_score")
  @@index([leadIntelligence], map: "idx_lead_leadintelligence_gin", type: Gin)
  @@index([phone], map: "idx_lead_phone")
  @@index([riskScore], map: "idx_lead_riskscore")
  @@index([createdAt(sort: Desc)], map: "lead_createdat_idx")
  @@index([email], map: "lead_email_idx")
  @@index([flags], map: "lead_flags_gin", type: Gin)
  @@index([leadIntelligence], map: "lead_leadintelligence_gin", type: Gin)
  @@index([leadIntelligence], map: "lead_li_gin_idx", type: Gin)
  @@index([phone], map: "lead_phone_idx")
}

model Edital {
  id                  String       @id @default(uuid())
  name                String
  source              String
  sourceUrl           String
  country             String
  type                EditalType
  area                String
  categories          String[]
  minValue            Float?
  maxValue            Float?
  currency            String       @default("BRL")
  deadline            DateTime?
  applicationDeadline DateTime?
  status              EditalStatus @default(ABERTO)
  eligibility         String?
  applicationSteps    String?
  requiredDocs        String[]
  description         String?
  requirements        String?
  relevanceScore      Int          @default(0)
  matchedServices     String[]
  matchedProjects     String[]
  azimutFitNotes      String?
  contactEmail        String?
  contactName         String?
  contactPhone        String?
  contactLinkedIn     String?
  scrapedAt           DateTime     @default(now())
  lastChecked         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  leads               LeadEdital[]

  @@index([status])
  @@index([deadline])
  @@index([country])
  @@index([relevanceScore])
  @@index([source])
}

model LeadEdital {
  id              String           @id @default(uuid())
  editalId        String
  leadId          String
  emailSent       Boolean          @default(false)
  emailSentAt     DateTime?
  callScheduled   Boolean          @default(false)
  callScheduledAt DateTime?
  callLink        String?
  portfolioSent   Boolean          @default(false)
  portfolioSentAt DateTime?
  proposalSent    Boolean          @default(false)
  proposalSentAt  DateTime?
  status          LeadEditalStatus @default(PENDING)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  edital          Edital           @relation(fields: [editalId], references: [id], onDelete: Cascade)
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([editalId, leadId])
  @@index([status])
}

model Settings {
  id                               String   @id @default("singleton")
  siteName                         String?  @default("Azimut")
  siteUrl                          String?  @default("https://azmt.com.br")
  contactEmail                     String?
  contactPhone                     String?
  defaultMetaDescription           String?
  defaultKeywords                  String?
  ogImageUrl                       String?
  facebookUrl                      String?
  instagramUrl                     String?
  linkedinUrl                      String?
  twitterUrl                       String?
  youtubeUrl                       String?
  kabbamApiKey                     String?
  kabbamApiUrl                     String?
  smtpHost                         String?
  smtpPort                         Int?
  smtpUser                         String?
  smtpPassword                     String?
  smtpFromEmail                    String?
  deepseekApiKey                   String?
  notificationEmail                String?
  defaultLanguage                  String?  @default("pt")
  defaultCountry                   String?  @default("BR")
  timezone                         String?  @default("America/Sao_Paulo")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  web3RpcUrl                       String?
  web3NftContractAddress           String?
  web3StudentRewardContractAddress String?
  companyWalletAddress             String?
  companyWalletPrivateKeyEncrypted String?
  whatsappNumber                   String?
  vimeoUrl                         String?
  behanceUrl                       String?
}

model FooterSettings {
  id             String   @id @default("singleton")
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  instagramUrl   String?
  youtubeUrl     String?
  linkedinUrl    String?
  vimeoUrl       String?
  behanceUrl     String?
  facebookUrl    String?
  twitterUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Press {
  id           String    @id @default(uuid())
  titlePt      String
  titleEn      String?
  titleEs      String?
  titleFr      String?
  summaryPt    String?
  summaryEn    String?
  summaryEs    String?
  summaryFr    String?
  url          String?
  publishedAt  DateTime?
  displayOrder Int       @default(0)
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([isPublished])
  @@index([publishedAt])
  @@index([displayOrder])
}

model Publication {
  id           String   @id @default(uuid())
  titlePt      String
  titleEn      String?
  titleEs      String?
  titleFr      String?
  authors      String?
  url          String?
  year         Int?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([isPublished])
  @@index([year])
  @@index([displayOrder])
}

model QuizVancouverResponse {
  id              String   @id @default(uuid())
  sessionId       String?
  leadId          String?
  experience      String
  english         String
  goal            String
  area            String
