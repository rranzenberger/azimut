{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.azmt.com.br"
        }
      ],
      "destination": "https://azmt.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://azmt.com.br/:path*",
      "permanent": true
    }
  ],
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}

