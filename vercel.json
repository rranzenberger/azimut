{
  "buildCommand": "npm run vercel-build",
  "redirects": [
    { "source": "/gigradar", "destination": "/pt/gigradar", "permanent": false },
    { "source": "/beta", "destination": "/pt/gigradar", "permanent": false },
    { "source": "/giradar", "destination": "/pt/gigradar", "permanent": false },
    { "source": "/:lang/giradar", "destination": "/:lang/gigradar", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/)(?!fonts/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/fonts/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ],
  "git": {"deploymentEnabled": {"main": true}}
}
